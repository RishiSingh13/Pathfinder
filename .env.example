# Unified Learning Roadmap Application - Environment Template
# Duplicate this file to server/.env or root .env for local development

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database configuration
# Set MONGODB_URI to your local or remote MongoDB instance.
# When USE_IN_MEMORY_DB_IF_LOCAL_FAILS=true, the server automatically starts an
# isolated in-memory MongoDB instance if the primary MongoDB URI cannot be reached.
MONGODB_URI=mongodb://127.0.0.1:27017/roadmap_platform
USE_IN_MEMORY_DB_IF_LOCAL_FAILS=true

# Security Secrets (Must be distinct, high-entropy strings in production; min 32 characters)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_at_least_32_characters
COOKIE_SECRET=change_this_to_a_distinct_secure_cookie_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
